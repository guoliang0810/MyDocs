# ============================================
# MyDocs — 私有知识库忽略规则
# ============================================

# --- Python 生态 ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- IDE ---
.idea/
.vscode/
*.iml

# --- Obsidian 运行时状态（频繁变动，不入版本控制）---
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/*/data.json

# --- 系统与临时文件 ---
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
~$*
